{
  "routes": [
    {
      "route": "/assurance-by-design.html",
      "redirect": "/governance-by-design.html",
      "statusCode": 301
    },
    {
      "route": "/api/contact",
      "methods": ["POST"],
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/api/*",
      "statusCode": 404
    }
  ],
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  }
}
